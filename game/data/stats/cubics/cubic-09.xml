<?xml version="1.0" encoding="UTF-8"?>
<list xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xsd/cubics.xsd">
	<!--
	
		Attractive Cubic.
		Uses Cubic Hate and Hold to control valid combat targets.
	
		Attribute guide:
		duration: Cubic lifetime in seconds after summon.
		delay: Action interval in seconds between Cubic checks.
		maxCount: Maximum number of successful Cubic actions before the limit is reached.
		useUp: 1 consumes/removes the Cubic after maxCount; 0 keeps it until duration expires.
		power: Base magical power or effect power used by Cubic runtime formulas.
		selectionMode: Skill selection policy when the Cubic has multiple non-priority skills.
		targetType: Default target routing used by the Cubic runtime.
		BY_SKILL: Each skill entry defines its own target with the target attribute.
		priority: Priority skills are checked before regular Cubic skills.
		targetDebuff: Used by cure/support skills to select owner-side debuff cleanup logic.
		Epilogue note: Levels 8-12 are enchant/template levels used by high-level summon skills.
	
	-->
	<cubic id="9" level="1" slot="9" duration="900" delay="8" maxCount="300" useUp="1" power="1026.0" selectionMode="RANDOM" targetType="TARGET">
		<skills>
			<skill id="5115" level="1" /> <!-- Cubic Hate -->
			<skill id="5116" level="1" /> <!-- Hold -->
		</skills>
	</cubic>
